PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/merisamaj

# JWT Secrets
JWT_SECRET=merisamaj_default_jwt_secret_key_2026
JWT_REFRESH_SECRET=merisamaj_default_refresh_jwt_secret_key_2026
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Optional for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Optional for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
